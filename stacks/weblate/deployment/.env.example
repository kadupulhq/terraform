# Non-secret settings only. Copy to .env on the deployment host.
WEBLATE_DOMAIN=translate.kadupul.net
WEBLATE_ADMIN_EMAIL=owner@example.com
WEBLATE_EMAIL_HOST=smtp.example.com
# Use a provider-supported alternative port; DigitalOcean blocks 25/465/587.
WEBLATE_EMAIL_PORT=2525
WEBLATE_EMAIL_HOST_USER=replace-with-smtp-user
WEBLATE_FROM_EMAIL=translations@kadupul.net
WEBLATE_SECRETS_DIR=/etc/kadupul-weblate/secrets
